# ─────────────────────────────────────────────────────────────────────────────
# Nexus Chat — Backend Environment Variables
#
# Copy this file to backend/.env and fill in real values before running.
# Never commit backend/.env to source control.
# ─────────────────────────────────────────────────────────────────────────────

# Django core
DEBUG=True
SECRET_KEY=django-insecure-change-me-in-production

# Comma-separated list of allowed hosts
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS — allow the Vite dev server to call the API
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# CSRF — must include all origins that submit forms
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database
# SQLite (default for local development — no extra setup required):
# DATABASE_URL is left empty, settings.py falls back to SQLite automatically.
# DATABASE_URL=sqlite:///db.sqlite3
#
# PostgreSQL (recommended for staging/production):
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DB_NAME

# Redis — used by Django Channels for the channel layer.
# Leave empty to use the in-memory channel layer (no Redis required locally).
# For production, set a real Redis URL, e.g.:
# REDIS_URL=redis://localhost:6379/0
REDIS_URL=

# Cookie security — set to False for local HTTP development, True in production
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# SSL redirect — set to False locally, True in production behind HTTPS
SECURE_SSL_REDIRECT=False

# HSTS — leave at 0 locally; set seconds (e.g. 31536000) in production
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
