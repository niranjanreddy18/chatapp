# -----------------------------------------------------------------------------
# Nexus Chat — Backend Environment Variables (.env.example)
# Copy this file to .env and fill in the values for your environment.
# NEVER commit your actual .env file to version control.
# -----------------------------------------------------------------------------

# Django Core
SECRET_KEY=replace-with-a-cryptographically-secure-secret-key-min-50-chars
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (leave blank in development to use SQLite; set in production for PostgreSQL)
DATABASE_URL=

# Redis / Django Channels (leave blank in development to use InMemoryChannelLayer)
REDIS_URL=

# CORS & CSRF Origins (comma-separated list of allowed frontend origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT Token Lifetimes (in minutes / days)
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7

# Cloudinary Media Storage (optional in development, required for cloud media uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Production HTTPS / Cookie Security (automatically enabled when DEBUG=False)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
